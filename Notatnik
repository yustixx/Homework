import json
import os

FILE = "notes.json"

# Jeśli plik istnieje – wczytaj notatki, jeśli nie – zacznij od pustej listy
if os.path.exists(FILE):
    with open(FILE, "r", encoding="utf-8") as f:
        notes = json.load(f)
else:
    notes = []

while True:
    print("\n1. Dodaj notatkę")
    print("2. Wyświetl notatki")
    print("3. Usuń notatkę")
    print("4. Wyjście")

    choice = input("Wybierz opcję: ")

    if choice == "1":
        text = input("Wpisz notatkę: ")
        notes.append(text)
        with open(FILE, "w", encoding="utf-8") as f:
            json.dump(notes, f, ensure_ascii=False, indent=4)
        print("Dodano notatkę.")

    elif choice == "2":
        if not notes:
            print("Brak notatek.")
        else:
            for i, note in enumerate(notes, start=1):
                print(f"{i}. {note}")

    elif choice == "3":
        if not notes:
            print("Brak notatek do usunięcia.")
        else:
            try:
                nr = int(input("Podaj numer notatki do usunięcia: "))
                if 1 <= nr <= len(notes):
                    notes.pop(nr - 1)
                    with open(FILE, "w", encoding="utf-8") as f:
                        json.dump(notes, f, ensure_ascii=False, indent=4)
                    print("Usunięto notatkę.")
                else:
                    print("Nie ma takiego numeru.")
            except ValueError:
                print("Podaj liczbę.")

    elif choice == "4":
        print("Koniec programu.")
        break

    else:
        print("Niepoprawny wybór.")
